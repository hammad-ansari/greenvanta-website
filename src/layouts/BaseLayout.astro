---
import "../styles/fonts.css";
import "../styles/global.css";
import frauncesLatin from "@fontsource/fraunces/files/fraunces-latin-500-normal.woff2?url";
import outfitLatin from "@fontsource/outfit/files/outfit-latin-400-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { graph, organizationNode } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  robots?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, robots = "index, follow", jsonLd = [] } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL("/og.jpg", Astro.site).href : "/og.jpg";
const structuredData = graph([organizationNode(Astro.site), ...jsonLd]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={outfitLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#143326" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GreenVanta wordmark with the moringa capsule bottle and mushroom coffee pouch." />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={structuredData} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch.png" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const panel = document.querySelector<HTMLElement>("#site-nav");

      const setOpen = (open: boolean) => {
        panel?.classList.toggle("is-open", open);
        toggle?.setAttribute("aria-expanded", String(open));
        toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      };

      toggle?.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      panel?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setOpen(false);
      });

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const nodes = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce || !("IntersectionObserver" in window)) {
        nodes.forEach((node) => node.classList.add("is-in"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-in");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.14, rootMargin: "0px 0px -8% 0px" },
        );
        nodes.forEach((node) => observer.observe(node));
      }
    </script>
  </body>
</html>
