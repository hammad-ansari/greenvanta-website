---
import { storeUrl } from "../data/site";

const path = Astro.url.pathname;
const links = [
  { href: "/products/moringa/", label: "Moringa" },
  { href: "/products/mushroom-coffee/", label: "Mushroom coffee" },
  { href: "/#story", label: "The line" },
];
---

<header class="site-header">
  <div class="header-bar">
    <a class="logo" href="/">
      <img
        src="/images/logo-wordmark.webp"
        alt="GreenVanta"
        width="360"
        height="98"
        decoding="async"
      />
    </a>
    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <span class="burger"></span>
    </button>
    <nav id="site-nav" class="nav-panel" aria-label="Primary">
      <ul class="nav-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn" href={storeUrl} target="_blank" rel="noopener noreferrer">
        Amazon store
        <span class="sr">Opens in a new tab.</span>
      </a>
    </nav>
  </div>
</header>

<noscript>
  <style>
    .nav-toggle { display: none !important; }
    .nav-panel { display: flex !important; position: static !important; }
    @media (max-width: 980px) {
      .nav-panel { flex-direction: column; align-items: flex-start; padding: 0 0 1rem; }
      .nav-links { flex-direction: column; align-items: flex-start; }
    }
  </style>
</noscript>
